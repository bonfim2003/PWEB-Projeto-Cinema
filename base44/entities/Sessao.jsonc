{
  "name": "Sessao",
  "type": "object",
  "properties": {
    "filme_id": {
      "type": "string",
      "title": "Filme"
    },
    "filme_titulo": {
      "type": "string",
      "title": "T\u00edtulo do filme"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "horario": {
      "type": "string",
      "title": "Hor\u00e1rio"
    },
    "local": {
      "type": "string",
      "title": "Local"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "ativa",
        "cancelada"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "ativa"
    }
  },
  "required": [
    "filme_id",
    "data",
    "horario"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}