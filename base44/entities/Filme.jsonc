{
  "name": "Filme",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "genero": {
      "type": "string",
      "title": "G\u00eanero"
    },
    "sinopse": {
      "type": "string",
      "title": "Sinopse"
    },
    "duracao": {
      "type": "number",
      "title": "Dura\u00e7\u00e3o (minutos)"
    },
    "ano": {
      "type": "number",
      "title": "Ano de lan\u00e7amento"
    },
    "diretor": {
      "type": "string",
      "title": "Dire\u00e7\u00e3o"
    },
    "classificacao": {
      "type": "string",
      "title": "Classifica\u00e7\u00e3o indicativa",
      "enum": [
        "Livre",
        "10 anos",
        "12 anos",
        "14 anos",
        "16 anos",
        "18 anos"
      ],
      "enumColors": [
        "green",
        "green",
        "yellow",
        "yellow",
        "red",
        "red"
      ]
    },
    "poster_url": {
      "type": "string",
      "title": "P\u00f4ster"
    },
    "trailer_url": {
      "type": "string",
      "title": "Trailer (link do YouTube)"
    },
    "destaque": {
      "type": "boolean",
      "title": "Destaque na home",
      "default": false
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}