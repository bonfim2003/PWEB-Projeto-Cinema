{
  "name": "Reserva",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo da reserva"
    },
    "sessao_id": {
      "type": "string",
      "title": "Sess\u00e3o"
    },
    "setor_id": {
      "type": "string",
      "title": "Setor"
    },
    "filme_titulo": {
      "type": "string",
      "title": "Filme"
    },
    "filme_poster": {
      "type": "string",
      "title": "P\u00f4ster"
    },
    "sessao_data": {
      "type": "string",
      "title": "Data da sess\u00e3o"
    },
    "sessao_horario": {
      "type": "string",
      "title": "Hor\u00e1rio da sess\u00e3o"
    },
    "local": {
      "type": "string",
      "title": "Local"
    },
    "setor_nome": {
      "type": "string",
      "title": "Setor escolhido"
    },
    "nome": {
      "type": "string",
      "title": "Nome do visitante"
    },
    "email": {
      "type": "string",
      "title": "E-mail do visitante"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade de ingressos"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "confirmada",
        "cancelada"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "confirmada"
    },
    "user_id": {
      "type": "string",
      "title": "Usu\u00e1rio"
    }
  },
  "required": [
    "codigo",
    "sessao_id",
    "setor_id",
    "nome",
    "email",
    "quantidade"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}